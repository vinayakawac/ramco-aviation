{
  "name": "ramco-aviation-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Scroll-driven 3D flight journey built from the Ramco Aviation source page data",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test:coverage": "node test/coverage.test.js",
    "models:build": "node tools/build-models.mjs",
    "models:measure": "node tools/measure-airframe.mjs assets/models/gltf2/*.glb"
  },
  "dependencies": {
    "lenis": "^1.3.11",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "gltf-pipeline": "^4.3.1",
    "playwright": "^1.56.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}